{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "fundamentos_cvm",
 "type": "object",
 "required": [
  "data_coleta",
  "fonte",
  "tickers"
 ],
 "properties": {
  "data_coleta": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}"
  },
  "fonte": {
   "type": "string"
  },
  "tickers": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "ticker",
     "situacao"
    ],
    "properties": {
     "ticker": {
      "type": "string"
     },
     "situacao": {
      "type": "string",
      "enum": [
       "ok",
       "sem_dado_cvm",
       "sem_demonstracoes"
      ]
     },
     "valores": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "valor",
        "unidade",
        "certeza",
        "metodo"
       ],
       "properties": {
        "valor": {
         "type": [
          "number",
          "string",
          "null"
         ]
        },
        "unidade": {
         "type": "string"
        },
        "certeza": {
         "type": "string",
         "enum": [
          "alta",
          "média",
          "baixa"
         ]
        },
        "metodo": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}