{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "decisao_sombra",
 "type": "object",
 "required": ["modo", "conclusao_geral", "ranking_confiavel", "decisoes"],
 "properties": {
  "modo": {"type": "string", "enum": ["sombra"]},
  "conclusao_geral": {"type": "string", "minLength": 1},
  "ranking_confiavel": {"type": "boolean"},
  "decisoes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["ticker", "acao", "acao_ranking", "tese", "evidencias_ids", "argumentos_contrarios",
                 "alternativas_rejeitadas", "invalidadores", "confianca", "dados_ausentes", "revisar_quando"],
    "properties": {
     "ticker": {"type": "string", "minLength": 1},
     "acao": {"type": "string", "enum": ["comprar", "aguardar", "evitar", "dados_insuficientes"]},
     "acao_ranking": {"type": "string"},
     "tese": {"type": "string", "minLength": 1},
     "evidencias_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "argumentos_contrarios": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "alternativas_rejeitadas": {"type": "array", "items": {"type": "object", "required": ["ticker", "motivo"]}},
     "invalidadores": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "confianca": {"type": "string", "enum": ["alta", "média", "baixa"]},
     "dados_ausentes": {"type": "array", "items": {"type": "string"}},
     "revisar_quando": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "independencia_evidencias": {
      "type": "object",
      "required": ["fontes_independentes"],
      "properties": {
       "fontes_independentes": {"type": "integer", "minimum": 0},
       "grupos_mesma_origem": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
       "observacao": {"type": "string"}
      }
     }
    }
   }
  }
 }
}
