{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "dossie_qualitativo",
 "type": "object",
 "additionalProperties": {
  "type": "object",
  "additionalProperties": {
   "type": "object",
   "required": [
    "valor",
    "fonte",
    "data",
    "certeza"
   ],
   "properties": {
    "valor": {
     "type": [
      "string",
      "number"
     ]
    },
    "fonte": {
     "type": "string",
     "minLength": 2
    },
    "url": {
     "type": "string"
    },
    "data": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}(-\\d{2})?"
    },
    "certeza": {
     "type": "string",
     "enum": [
      "alta",
      "média",
      "baixa"
     ]
    }
   }
  }
 }
}